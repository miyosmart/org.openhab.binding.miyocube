<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="miyocube"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="cube">
		<label>MiyoCube Binding Bridge</label>
		<description>Bridge for MiyoCube things</description>

		<config-description>
			<parameter name="host" type="text" required="true">
				<context>network-address</context>
				<label>IP</label>
				<description>IP address of the Miyo Cube</description>
			</parameter>
		</config-description>
	</bridge-type>

	<thing-type id="sensor">
		<supported-bridge-type-refs>
			<bridge-type-ref id="cube"/>
		</supported-bridge-type-refs>

		<label>MiyoCube Sensor</label>
		<description>Miyo Sensor Thing for MiyoCube Binding</description>

		<channels>
			<channel id="temperature" typeId="temperature"/>
			<channel id="moisture" typeId="moisture"/>
			<channel id="brightness" typeId="brightness"/>
			<channel id="solar-voltage" typeId="solar-voltage"/>
			<channel id="last-update" typeId="last-update"/>
		</channels>
	</thing-type>

	<thing-type id="valve">
		<supported-bridge-type-refs>
			<bridge-type-ref id="cube"/>
		</supported-bridge-type-refs>

		<label>MiyoCube Valve</label>
		<description>Miyo Valve Thing for MiyoCube Binding</description>

		<channels>
			<channel id="valve-status" typeId="valve-status"/>
			<channel id="solar-voltage" typeId="solar-voltage"/>
			<channel id="last-update" typeId="last-update"/>
		</channels>
	</thing-type>

	<thing-type id="circuit">
		<supported-bridge-type-refs>
			<bridge-type-ref id="cube"/>
		</supported-bridge-type-refs>

		<label>MiyoCube Circuit</label>
		<description>Miyo Irrigation Circuit Thing for MiyoCube Binding</description>

		<channels>
			<channel id="irrigation-was-started" typeId="irrigation-was-started"/>
			<channel id="valve-staggering" typeId="valve-staggering"/>
			<channel id="automatic-mode" typeId="automatic-mode"/>
			<channel id="start-irrigation" typeId="start-irrigation"/>
			<channel id="stop-irrigation" typeId="stop-irrigation"/>
			<channel id="duration" typeId="duration"/>
		</channels>
	</thing-type>

	<channel-type id="temperature">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>
	<channel-type id="moisture">
		<item-type>Number:Dimensionless</item-type>
		<label>Moisture (0-100%)</label>
		<state pattern="%.0f %%" readOnly="true"/>
	</channel-type>
	<channel-type id="brightness">
		<item-type>Number:Illuminance</item-type>
		<label>Brightness</label>
		<tags>
			<tag>Measurement</tag>
			<tag>Illuminance</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>
	<channel-type id="valve-status">
		<item-type>Switch</item-type>
		<label>Valve status</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="solar-voltage">
		<item-type>Number:ElectricPotential</item-type>
		<label>Solar voltage</label>
		<state pattern="%.1f %unit%" readOnly="true"/>
	</channel-type>
	<channel-type id="last-update">
		<item-type>DateTime</item-type>
		<label>Last update</label>
		<state pattern="%1$td.%1$tm.%1$tY %1$tH:%1$tM:%1$tS" readOnly="true"/>
	</channel-type>
	<channel-type id="irrigation-was-started">
		<item-type>Switch</item-type>
		<label>Irrigation active</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="valve-staggering">
		<item-type>Switch</item-type>
		<label>Valve staggering</label>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="automatic-mode">
		<item-type>Switch</item-type>
		<label>Automatic irrigation</label>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="start-irrigation">
		<item-type>Switch</item-type>
		<label>Start irrigation</label>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="stop-irrigation">
		<item-type>Switch</item-type>
		<label>Stop irrigation</label>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="duration">
		<item-type>Number:Time</item-type>
		<label>Irrigation duration</label>
		<state min="1" max="59" step="1" pattern="%d min" readOnly="false"/>
	</channel-type>

</thing:thing-descriptions>
